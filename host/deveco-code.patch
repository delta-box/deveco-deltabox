+import { expect, test } from "bun:test"
+import { ReviewGate, pendingReview } from "../../src/plugin/deltabox/review"
+import type { Client } from "../../src/plugin/deltabox/client"
+import { Runtime } from "../../src/plugin/deltabox/runtime"
+import { parseConfig } from "../../src/plugin/deltabox/config"
+import { tmpdir } from "../fixture/fixture"
+
+test("confirmation switches per root session without acquiring a project lease", async () => {
+  await using tmp = await tmpdir()
+  const runtime = new Runtime(
+    tmp.path,
+    parseConfig({}),
+    {
+      async parent(id) {
+        return id === "child" ? "parent" : undefined
+      },
+      async notify() {},
+    },
+    () => {
+      throw new Error("Confirmation must not start a sandbox")
+    },
+  )
+  try {
+    expect(await runtime.command("parent", "sandbox-confirmation", "")).toBe("Confirmation: command.")
+    expect(await runtime.command("parent", "sandbox-confirmation", "dialog")).toContain("Confirmation: dialog.")
+    expect(await runtime.command("child", "sandbox-confirmation", "")).toBe("Confirmation: dialog.")
+    expect(await runtime.command("other", "sandbox-confirmation", "")).toBe("Confirmation: command.")
+    await runtime.idle("parent")
+    expect(await runtime.command("parent", "sandbox-confirmation", "")).toBe("Confirmation: dialog.")
+    await expect(runtime.command("parent", "sandbox-confirmation", "invalid")).rejects.toThrow("Usage:")
+    await expect(runtime.command("parent", "sandbox-confirmation", "command dialog")).rejects.toThrow("Usage:")
+    expect(await runtime.command("parent", "sandbox-confirmation", "")).toBe("Confirmation: dialog.")
+    await runtime.command("child", "sandbox-confirmation", "command")
+    expect(await runtime.command("parent", "sandbox-confirmation", "")).toBe("Confirmation: command.")
+  } finally {
+    await runtime.dispose()
+  }
+})
+
+for (const mode of ["task", "tool", "risky"] as const) {
+  test(`${mode} reports pending changes repeatedly without accepting them`, async () => {
+    const calls: string[] = []
+    const client = {
+      async active() {
+        return { checkpoint_id: "original", kind: mode, label: null, started_at_ms: 0 }
+      },
+      async review() {
+        return {
+          from: "original",
+          to: null,
+          pending_changes: 1,
+          changes: [
+            {
+              path: "example.txt",
+              kind: "added",
+              old_size: null,
+              new_size: 4,
+              is_binary: false,
+              added_lines: 1,
+              removed_lines: 0,
+            },
+          ],
+        }
+      },
+      async commit() {
+        calls.push("commit")
+        return { checkpoint_id: "original", applied: 1 }
+      },
+    } satisfies Pick<Client, "active" | "review" | "commit">
+    const first = await pendingReview(client)
+    expect(first).toContain("example.txt")
+    expect(first).toContain("/sandbox-diff")
+    expect(first).toContain("/sandbox-commit")
+    expect(first).toContain("/sandbox-abort")
+    expect(await pendingReview(client)).toBe(first)
+    expect(calls).toEqual([])
+  })
+}
+
+test("an empty review is closed without asking for approval", async () => {
+  const calls: string[] = []
+  expect(
+    await pendingReview({
+      async active() {
+        return { checkpoint_id: "empty", kind: "task", label: null, started_at_ms: 0 }
+      },
+      async review() {
+        return { from: "empty", to: null, pending_changes: 0, changes: [] }
+      },
+      async commit() {
+        calls.push("commit")
+        return { checkpoint_id: "empty", applied: 0 }
+      },
+    }),
+  ).toBe("No pending changes.")
+  expect(calls).toEqual(["commit"])
+})
+
+for (const reply of ["once", "reject"] as const) {
+  test(`dialog confirmation ${reply} settles the pending review`, async () => {
+    const gate = new ReviewGate()
+    const calls: string[] = []
+    const result = await gate.review(
+      {
+        async active() {
+          return { checkpoint_id: "original", kind: "task", label: null, started_at_ms: 0 }
+        },
+        async review() {
+          return { from: "original", to: null, pending_changes: 1, changes: [] }
+        },
+        async commit() {
+          calls.push("commit")
+          return { checkpoint_id: "original", applied: 1 }
+        },
+        async abort() {
+          calls.push("abort")
+          return { checkpoint_id: "original", restored: 1 }
+        },
+      },
+      {
+        sessionID: "session",
+        messageID: "message",
+        agent: "build",
+        directory: ".",
+        worktree: ".",
+        abort: new AbortController().signal,
+        metadata() {},
+        async ask(input) {
+          expect(input.permission).toBe("deltabox_review")
+          expect(calls).toEqual([])
+          calls.push("ask")
+          gate.event({ type: "permission.asked", properties: { ...input, sessionID: "session", id: "request" } })
+          gate.event({ type: "permission.replied", properties: { sessionID: "session", requestID: "request", reply } })
+          if (reply === "reject") throw new Error("Rejected")
+        },
+      },
+    )
+    expect(calls).toEqual(["ask", reply === "once" ? "commit" : "abort"])
+    expect(result).toContain(reply === "once" ? "Accepted 1" : "Rolled back 1")
+  })
+}
