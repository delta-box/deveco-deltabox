+import { expect } from "bun:test"
+import { Effect, Layer } from "effect"
+import path from "node:path"
+import { pathToFileURL } from "node:url"
+import { Config } from "@/config/config"
+import { InstanceState } from "@/effect/instance-state"
+import { createLanguage } from "@/plugin/deltabox/language"
+import { Runtime } from "@/plugin/deltabox/runtime"
+import { parseConfig } from "@/plugin/deltabox/config"
+import { makeTools } from "@/plugin/deltabox/tools"
+import { tmpdir } from "../fixture/fixture"
+import { testEffect } from "../lib/effect"
+
+const it = testEffect(Layer.mergeAll(Config.defaultLayer))
+
+it.instance("runs the existing formatter and LSP in the view and releases their caches", () =>
+  Effect.gen(function* () {
+    const instance = yield* InstanceState.context
+    const config = yield* (yield* Config.Service).get()
+    yield* Effect.promise(async () => {
+      await using mount = await tmpdir()
+      const file = path.join(instance.directory, "中文 space.mounted")
+      const mountedFile = path.join(mount.path, "中文 space.mounted")
+      const log = path.join(instance.directory, "lsp.log")
+      await Bun.write(file, "host content\n")
+      await Bun.write(mountedFile, "invalid private content")
+      const formatter = path.join(instance.directory, "formatter.mjs")
+      await Bun.write(
+        formatter,
+        `import { readFileSync, writeFileSync } from "node:fs"
+if (process.cwd() !== ${JSON.stringify(mount.path)}) throw new Error("wrong cwd")
+writeFileSync(process.argv[2], readFileSync(process.argv[2], "utf8").trim() + "\\n")`,
+      )
+      config.formatter = { mounted: { extensions: [".mounted"], command: [process.execPath, formatter, "$FILE"] } }
+      config.lsp = {
+        mounted: {
+          extensions: [".mounted"],
+          command: [process.execPath, path.join(import.meta.dir, "fixtures/mounted-lsp.mjs"), log],
+        },
+      }
+      const language = createLanguage(instance, config)
+      const view = { project: instance.directory, mountpoint: mount.path }
+      try {
+        const diagnostics = await language.afterWrite(view, file)
+        expect(await Bun.file(mountedFile).text()).toBe("invalid private content\n")
+        expect(await Bun.file(file).text()).toBe("host content\n")
+        expect(diagnostics).toContain("invalid private content")
+        expect(diagnostics).toContain(file)
+        expect(diagnostics).not.toContain(mount.path)
+        const initialized = JSON.parse((await Bun.file(log).text()).split("\n")[0])
+        expect(initialized.cwd).toBe(mount.path)
+        expect(initialized.rootUri).toBe(pathToFileURL(mount.path).href)
+        expect(initialized.workspaceFolders[0].uri).toBe(pathToFileURL(mount.path).href)
+
+        const args = { filePath: file, line: 1, character: 1 }
+        const definition = await language.query(view, { ...args, operation: "goToDefinition" })
+        expect(definition.metadata.result).toMatchObject([{ uri: pathToFileURL(file).href }])
+        expect(definition.output).not.toContain(pathToFileURL(mount.path).href)
+        const hover = await language.query(view, { ...args, operation: "hover" })
+        expect(hover.output).toContain("invalid private content")
+        await expect(
+          language.query(view, {
+            ...args,
+            filePath: path.join(instance.directory, "..", "outside.mounted"),
+            operation: "hover",
+          }),
+        ).rejects.toThrow("outside the language workspace")
+
+        await language.dispose(view)
+        expect(() => process.kill(initialized.pid, 0)).toThrow()
+        // A rollback or replacement at the same mount path must not reuse old documents.
+        await Bun.write(mountedFile, "restored private content\n")
+        const restored = await language.query(view, { ...args, operation: "hover" })
+        expect(restored.output).toContain("restored private content")
+        expect((await Bun.file(log).text()).split("\n").filter((line) => line.startsWith("{"))).toHaveLength(2)
+      } finally {
+        await language.dispose(view)
+      }
+    })
+  }),
+)
+
+it.instance("preserves disabled language settings without touching files", () =>
