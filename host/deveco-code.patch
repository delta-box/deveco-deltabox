diff --git a/packages/core/src/util/deltabox-review.ts b/packages/core/src/util/deltabox-review.ts
new file mode 100644
index 0000000..45ac0ba
--- /dev/null
+++ b/packages/core/src/util/deltabox-review.ts
@@ -0,0 +1,36 @@
+export type DeltaboxChange = {
+  path: string
+  kind: "added" | "modified" | "deleted"
+  added_lines: number
+  removed_lines: number
+  is_binary: boolean
+}
+
+// Permission metadata can also come from third-party plugins or older sessions.
+// Both renderers use the same validation before displaying a review summary.
+export function deltaboxReview(metadata: Record<string, unknown> = {}) {
+  const changes = Array.isArray(metadata.changes) ? metadata.changes.filter(isChange) : []
+  const mode = metadata.reviewMode === "tool" || metadata.reviewMode === "risky" ? metadata.reviewMode : "task"
+  const count = nonnegative(metadata.pendingChanges) ? metadata.pendingChanges : changes.length
+  return { changes, mode, count }
+}
+
+function nonnegative(value: unknown): value is number {
+  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0
+}
+
+function isChange(value: unknown): value is DeltaboxChange {
+  if (!value || typeof value !== "object") return false
+  return (
+    "path" in value &&
+    typeof value.path === "string" &&
+    "kind" in value &&
+    (value.kind === "added" || value.kind === "modified" || value.kind === "deleted") &&
+    "added_lines" in value &&
+    nonnegative(value.added_lines) &&
+    "removed_lines" in value &&
+    nonnegative(value.removed_lines) &&
+    "is_binary" in value &&
+    typeof value.is_binary === "boolean"
+  )
+}
diff --git a/packages/opencode/src/session/stopping.ts b/packages/opencode/src/session/stopping.ts
new file mode 100644
index 0000000..cdd11ea
--- /dev/null
+++ b/packages/opencode/src/session/stopping.ts
@@ -0,0 +1,50 @@
+import { Effect } from "effect"
+import { EffectBridge } from "@/effect/bridge"
+import { InstanceState } from "@/effect/instance-state"
+import { Plugin } from "@/plugin"
+import { Permission } from "@/permission"
+import { Agent } from "@/agent/agent"
+import { Session } from "./session"
+import { SessionID, MessageID } from "./schema"
+
+export const run = Effect.fn("SessionStopping.run")(function* (input: {
+  sessionID: SessionID
+  messageID: MessageID
+  agent: string
+}) {
+  const plugin = yield* Plugin.Service
+  const permission = yield* Permission.Service
+  const bridge = yield* EffectBridge.make()
+  const ctx = yield* InstanceState.context
+  const session = yield* (yield* Session.Service).get(input.sessionID).pipe(Effect.orDie)
+  const agent = yield* (yield* Agent.Service).get(input.agent)
+  yield* Effect.promise((signal) =>
+    bridge.promise(
+      plugin.trigger(
+        "session.turn.stopping",
+        {
+          ...input,
+          directory: ctx.directory,
+          worktree: ctx.worktree,
+          abort: signal,
+          metadata() {},
+          ask: (request) =>
+            bridge.promise(
+              permission
+                .ask({
+                  ...request,
+                  sessionID: input.sessionID,
+                  ruleset: Permission.merge(agent?.permission ?? [], session.permission ?? []),
+                })
+                .pipe(Effect.orDie),
+              { signal },
+            ),
+        },
+        {},
+      ),
+      { signal },
+    ),
+  )
+})
+
+export * as SessionStopping from "./stopping"
