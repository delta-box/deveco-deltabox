+import { describe, expect, test } from "bun:test"
+import path from "node:path"
+import { bundleDeltabox } from "../../script/vendor-deltabox"
+import { tmpdir } from "../fixture/fixture"
+
+const version = "0.1.4"
+
+describe("Deltabox distribution", () => {
+  test("keeps unsupported distributions free of native binaries", async () => {
+    await using tmp = await tmpdir()
+    const vendorDir = path.join(tmp.path, "vendor")
+    await bundleDeltabox({
+      version,
+      cacheDir: path.join(tmp.path, "cache"),
+      vendorDir,
+      target: { os: "freebsd", arch: "x64" },
+      offline: true,
+    })
+    expect(await Bun.file(path.join(vendorDir, "LICENSE")).exists()).toBe(true)
+    expect(await Bun.file(path.join(vendorDir, "deltabox.node")).exists()).toBe(false)
+  })
+
+  test("rejects Windows architectures without a published runtime", async () => {
+    await using tmp = await tmpdir()
+    await expect(
+      bundleDeltabox({
+        version,
+        cacheDir: path.join(tmp.path, "cache"),
+        vendorDir: path.join(tmp.path, "vendor"),
+        target: { os: "win32", arch: "arm64" },
+        offline: true,
+      }),
+    ).rejects.toThrow("Unsupported Deltabox architecture")
+  })
+
+  for (const target of [
+    { os: "darwin", arch: "arm64" },
+    { os: "win32", arch: "x64" },
+  ]) {
+    test(`refuses an incomplete ${target.os} native cache during an offline build`, async () => {
+      await using tmp = await tmpdir()
+      await expect(
+        bundleDeltabox({
+          version,
+          cacheDir: path.join(tmp.path, "cache"),
+          vendorDir: path.join(tmp.path, "vendor"),
+          target,
+          offline: true,
+        }),
+      ).rejects.toThrow("Offline vendor cache miss")
+    })
+  }
+
+  for (const target of [
+    { os: "darwin", arch: "arm64", name: "deltabox-lite-darwin-arm64", binary: "deltabox" },
+    { os: "darwin", arch: "x64", name: "deltabox-lite-darwin-x64", binary: "deltabox" },
+    { os: "linux", arch: "arm64", name: "deltabox-lite-linux-arm64", binary: "deltabox" },
+    { os: "linux", arch: "x64", name: "deltabox-lite-linux-x64", binary: "deltabox" },
+    { os: "win32", arch: "x64", name: "deltabox-lite-windows-x64", binary: "deltabox.exe" },
+  ]) {
+    test(`copies ${target.os}/${target.arch} executable, addon and license into packable paths`, async () => {
+      await using tmp = await tmpdir()
+      const cacheDir = path.join(tmp.path, "cache")
+      const pkg = path.join(cacheDir, "deltabox", version, `${target.os}-${target.arch}`, "node_modules", target.name)
+      for (const [name, body] of Object.entries({
+        "package.json": JSON.stringify({ version }),
+        [`bin/${target.binary}`]: "executable fixture",
+        "native/deltabox.node": "addon fixture",
+        LICENSE: "license fixture",
+      })) {
+        await Bun.write(path.join(pkg, name), body)
+      }
+      const vendorDir = path.join(tmp.path, "vendor/deltabox")
+      await bundleDeltabox({ version, cacheDir, vendorDir, target, offline: true })
+      expect(await Bun.file(path.join(vendorDir, target.binary)).text()).toBe("executable fixture")
+      expect(await Bun.file(path.join(vendorDir, "deltabox.node")).text()).toBe("addon fixture")
+      expect(await Bun.file(path.join(vendorDir, "RUNTIME-LICENSE")).text()).toBe("license fixture")
+      expect(await Bun.file(path.join(vendorDir, "runtime.json")).json()).toEqual({
+        name: target.name,
+        version,
+        target: `${target.os}-${target.arch}`,
+      })
+    })
+  }
+})
