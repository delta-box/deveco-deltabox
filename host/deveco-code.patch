diff --git a/packages/opencode/script/vendor-deltabox.ts b/packages/opencode/script/vendor-deltabox.ts
new file mode 100644
index 000000000..088e7bc2e
--- /dev/null
+++ b/packages/opencode/script/vendor-deltabox.ts
@@ -0,0 +1,62 @@
+import { $ } from "bun"
+import fs from "node:fs/promises"
+import path from "node:path"
+
+export async function bundleDeltabox(opts: {
+  version: string
+  cacheDir: string
+  vendorDir: string
+  target: { os: string; arch: string }
+  offline?: boolean
+}) {
+  await fs.mkdir(opts.vendorDir, { recursive: true })
+  const source = path.resolve(import.meta.dir, "../src/plugin/deltabox")
+  for (const name of ["LICENSE", "NOTICE.md"]) {
+    await fs.copyFile(path.join(source, name), path.join(opts.vendorDir, name))
+  }
+  if (!["darwin", "linux", "win32"].includes(opts.target.os)) return
+  if (!["arm64", "x64"].includes(opts.target.arch) || (opts.target.os === "win32" && opts.target.arch !== "x64"))
+    throw new Error("Unsupported Deltabox architecture")
+  if (!/^\d+\.\d+\.\d+$/.test(opts.version)) throw new Error("Deltabox runtime version must be pinned")
+  const target = `${opts.target.os}-${opts.target.arch}`
+  const name = `deltabox-lite-${opts.target.os === "win32" ? "windows" : opts.target.os}-${opts.target.arch}`
+  const binary = opts.target.os === "win32" ? "deltabox.exe" : "deltabox"
+  const cache = path.join(opts.cacheDir, "deltabox", opts.version, target)
+  const pkg = path.join(cache, "node_modules", name)
+  const manifest = Bun.file(path.join(pkg, "package.json"))
+  const ready =
+    (await manifest.exists()) &&
+    (await manifest.json()).version === opts.version &&
+    (await Bun.file(path.join(pkg, "bin", binary)).exists()) &&
+    (await Bun.file(path.join(pkg, "native/deltabox.node")).exists()) &&
+    (await Bun.file(path.join(pkg, "LICENSE")).exists())
+  if (!ready) {
+    if (opts.offline) throw new Error(`Offline vendor cache miss for deltabox-lite@${opts.version} (${target})`)
+    await fs.rm(cache, { recursive: true, force: true })
+    await fs.mkdir(cache, { recursive: true })
+    await Bun.write(
+      path.join(cache, "package.json"),
+      JSON.stringify({
+        name: "deveco-deltabox-vendor",
+        private: true,
+        dependencies: { [name]: opts.version },
+      }),
+    )
+    const registry = process.env.NPM_REGISTRY ? [`--registry=${process.env.NPM_REGISTRY}`] : []
+    await $`${process.execPath} install --production --ignore-scripts --linker=hoisted --os=${opts.target.os} --cpu=${opts.target.arch} ${registry}`.cwd(
+      cache,
+    )
+    if ((await Bun.file(path.join(pkg, "package.json")).json()).version !== opts.version)
+      throw new Error("Unexpected Deltabox runtime version")
+  }
+  // Keep sidecars outside node_modules: npm pack excludes nested node_modules.
+  // Copy failures (including a missing addon) fail the release build.
+  await fs.copyFile(path.join(pkg, "bin", binary), path.join(opts.vendorDir, binary))
+  await fs.chmod(path.join(opts.vendorDir, binary), 0o755)
+  await fs.copyFile(path.join(pkg, "native/deltabox.node"), path.join(opts.vendorDir, "deltabox.node"))
+  await fs.copyFile(path.join(pkg, "LICENSE"), path.join(opts.vendorDir, "RUNTIME-LICENSE"))
+  await Bun.write(
+    path.join(opts.vendorDir, "runtime.json"),
+    JSON.stringify({ name, version: opts.version, target }, null, 2) + "\n",
+  )
+}
