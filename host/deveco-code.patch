new file mode 100644
index 000000000..d767213f5
--- /dev/null
+++ b/packages/opencode/test/plugin/deltabox.e2e.mjs
@@ -0,0 +1,172 @@
+// SPDX-License-Identifier: Apache-2.0
+// Adapted from delta-box/deveco-deltabox tests (c36d20e); uses the built-in adapter.
+import { test } from "node:test"
+import assert from "node:assert/strict"
+import { existsSync, readFileSync, mkdtempSync, mkdirSync, copyFileSync, constants, rmSync } from "node:fs"
+import { tmpdir } from "node:os"
+import { join } from "node:path"
+import { spawn } from "node:child_process"
+import { once } from "node:events"
+import { startHost } from "./fixtures/deltabox-host.mjs"
+
+test(
+  "built-in Deltabox finishes turns without approval and retains changes for manual commands",
+  { skip: !process.env.DEVECO_BIN, timeout: 180000 },
+  async () => {
+    const host = await startHost()
+    const { api, project } = host
+    try {
+      const session = await api("/session", { title: "Deltabox manual review" })
+      const command = (command, args = "") => api(`/session/${session.id}/command`, { command, arguments: args })
+      const prompt = (label) =>
+        api(`/session/${session.id}/message`, {
+          parts: [{ type: "text", text: `[case:${label}] Apply the requested local test change.` }],
+        })
+      for (const label of ["accept", "reject", "cancel"]) {
+        await prompt(label)
+        assert.deepEqual(await api("/permission"), [], "turn must finish without approval")
+        assert.equal(existsSync(join(project, `${label}.txt`)), false)
+        const count = host.requests()
+        assert.match((await command("sandbox-diff")).parts[0].text, new RegExp(`${label}.txt`))
+        await command("sandbox-skip")
+        assert.match((await command("sandbox-review")).parts[0].text, new RegExp(`${label}.txt`))
+        await command(label === "accept" ? "sandbox-commit" : "sandbox-abort")
+        assert.equal(existsSync(join(project, `${label}.txt`)), label === "accept")
+        if (label === "accept") {
+          assert.equal(readFileSync(join(project, "accept.txt"), "utf8"), "reviewed\n")
+          assert.equal(readFileSync(join(project, "patch.txt"), "utf8"), "patched\n")
+        }
+        assert.match((await command("sandbox-status")).parts[0].text, /pending changes: 0/)
+        assert.equal(host.requests(), count, "manual review must not call the model")
+      }
+      await prompt("subagent")
+      assert.deepEqual(await api("/permission"), [])
+      assert.equal(existsSync(join(project, "child.txt")), false)
+      assert.match((await command("sandbox-diff")).parts[0].text, /child.txt/)
+      await command("sandbox-commit")
+      assert.equal(readFileSync(join(project, "child.txt"), "utf8"), "child\n")
+      for (const mode of ["task", "tool", "risky"]) {
+        await command("sandbox-mode", mode)
+        await prompt(`mode-${mode}`)
+        assert.deepEqual(await api("/permission"), [])
+        assert.equal(existsSync(join(project, `mode-${mode}-first.txt`)), false)
+        assert.equal(existsSync(join(project, `mode-${mode}-second.txt`)), false)
+        assert.match((await command("sandbox-status")).parts[0].text, /pending changes: 2/)
+        await command("sandbox-abort")
+        assert.match((await command("sandbox-status")).parts[0].text, /pending changes: 0/)
+      }
+      const auto = spawn(
+        process.env.DEVECO_BIN,
+        [
+          "run",
+          "--attach",
+          host.url,
+          "--dir",
+          project,
+          "--session",
+          session.id,
+          "--auto",
+          "--format",
+          "json",
+          "[case:auto] Write the automatic approval test file.",
+        ],
+        { cwd: project, env: host.env, stdio: ["ignore", "pipe", "pipe"] },
+      )
+      let output = ""
+      auto.stdout.on("data", (data) => {
+        output += data
+      })
+      auto.stderr.on("data", (data) => {
+        output += data
+      })
+      const timer = setTimeout(() => auto.kill("SIGKILL"), 30000)
+      try {
+        const [code] = await once(auto, "close")
+        assert.equal(code, 0, output)
+        assert.equal(existsSync(join(project, "auto.txt")), false, "--auto must not accept sandbox changes")
+        assert.deepEqual(await api("/permission"), [])
+        assert.match((await command("sandbox-diff")).parts[0].text, /auto.txt/)
+        await command("sandbox-commit")
+        assert.equal(readFileSync(join(project, "auto.txt"), "utf8"), "auto\n")
+      } finally {
+        clearTimeout(timer)
+        auto.kill()
+      }
+    } finally {
+      await host.close()
+    }
+  },
+)
+
+test(
+  "built-in Deltabox stays disabled without explicit opt-in",
+  { skip: !process.env.DEVECO_BIN, timeout: 60000 },
+  async () => {
+    const host = await startHost({ enabled: false })
+    try {
+      const tools = await host.api("/experimental/tool/ids")
+      assert.ok(!tools.includes("sandbox_review"))
+      const commands = await host.api("/command")
+      assert.ok(!commands.some((command) => command.name === "sandbox-status"))
+      const session = await host.api("/session", { title: "Default host behavior" })
+      await host.api(`/session/${session.id}/message`, {
+        parts: [{ type: "text", text: "[case:ordinary] Write ordinary.txt." }],
+      })
+      assert.equal(readFileSync(join(host.project, "ordinary.txt"), "utf8"), "ordinary\n")
+      assert.deepEqual(await host.api("/permission"), [])
+    } finally {
+      await host.close()
+    }
+  },
+)
+
+for (const transport of ["serve", "cli"]) {
+  test(
+    `bundled ${transport} transport executes without a global deltabox command`,
+    { skip: !process.env.DEVECO_BIN, timeout: 60000 },
+    async () => {
+      const host = await startHost({ transport })
+      try {
+        const session = await host.api("/session", { title: `${transport} runtime` })
+        await host.api(`/session/${session.id}/message`, {
+          parts: [{ type: "text", text: `[case:transport-${transport}] Write a file.` }],
+        })
+        assert.deepEqual(await host.api("/permission"), [])
+        assert.equal(existsSync(join(host.project, `transport-${transport}.txt`)), false)
+        await host.api(`/session/${session.id}/command`, { command: "sandbox-commit", arguments: "" })
+        assert.equal(readFileSync(join(host.project, `transport-${transport}.txt`), "utf8"), `transport-${transport}\n`)
+      } finally {
+        await host.close()
+      }
+    },
+  )
+}
+
+test(
+  "missing packaged runtime fails closed without falling back to host writes",
+  { skip: !process.env.DEVECO_BIN, timeout: 60000 },
+  async () => {
+    const root = mkdtempSync(join(tmpdir(), "deveco-missing-deltabox-"))
+    mkdirSync(join(root, "bin"))
+    const binary = join(root, "bin", process.platform === "win32" ? "deveco.exe" : "deveco")
+    copyFileSync(process.env.DEVECO_BIN, binary, constants.COPYFILE_FICLONE)
+    let host
+    try {
+      host = await startHost({ binary })
+      const session = await host.api("/session", { title: "Missing native runtime" })
+      await host.api(`/session/${session.id}/message`, {
+        parts: [{ type: "text", text: "[case:missing] Write missing.txt." }],
+      })
+      assert.equal(existsSync(join(host.project, "missing.txt")), false)
+      const messages = await host.api(`/session/${session.id}/message`)
+      const tools = messages.flatMap((message) => message.parts).filter((part) => part.type === "tool")
+      assert.ok(
+        tools.some((part) => part.state.status === "error" && /deltabox\.node/.test(part.state.error)),
+        JSON.stringify(tools),
+      )
+    } finally {
+      await host?.close()
+      rmSync(root, { recursive: true, force: true })
+    }
+  },
+)
