@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: Apache-2.0
+// File helper coverage adapted from deveco-deltabox e7a3e09 tests/windows.test.mjs.
+import { describe, expect, test } from "bun:test"
+import { spawnSync } from "node:child_process"
+import fs from "node:fs/promises"
+import path from "node:path"
+import { Shell } from "@opencode-ai/core/shell"
+import { which } from "@opencode-ai/core/util/which"
+import { loadConfig } from "../../src/plugin/deltabox/config"
+import { windowsArgv } from "../../src/plugin/deltabox/windows"
+import { tmpdir } from "../fixture/fixture"
+
+describe("Deltabox platform configuration", () => {
+  test("loads an explicit user config and preserves project precedence", async () => {
+    await using tmp = await tmpdir()
+    const project = path.join(tmp.path, "project")
+    await fs.mkdir(project)
+    const config = path.join(tmp.path, "user.json")
+    await Bun.write(
+      config,
+      JSON.stringify({ review: { mode: "tool" }, transport: "serve", bin: String.raw`tools\deltabox.exe` }),
+    )
+    await Bun.write(path.join(project, "deltabox.json"), JSON.stringify({ review: { mode: "risky" } }))
+    const previous = process.env.DEVECO_DELTABOX_CONFIG
+    process.env.DEVECO_DELTABOX_CONFIG = config
+    try {
+      expect(loadConfig(project)).toMatchObject({
+        review: { mode: "risky" },
+        transport: "serve",
+        bin: path.resolve(project, String.raw`tools\deltabox.exe`),
+      })
+      expect(loadConfig(project, path.join(tmp.path, "missing.json")).transport).toBe("native")
+      await Bun.write(config, "invalid config")
+      expect(() => loadConfig(project)).toThrow()
+    } finally {
+      if (previous === undefined) delete process.env.DEVECO_DELTABOX_CONFIG
+      else process.env.DEVECO_DELTABOX_CONFIG = previous
+    }
+  })
+
+  test("Windows file helpers preserve literal paths and include directories in find", async () => {
+    await using tmp = await tmpdir()
+    const run = (argv: string[]) => {
+      const [command, ...args] = windowsArgv(argv, tmp.path)
+      const result = spawnSync(command, args, { cwd: tmp.path, encoding: "utf8", timeout: 15000 })
+      if (result.error) throw result.error
+      return result
+    }
+    const file = path.join(tmp.path, "中文 ' $; notes.txt")
+    await Bun.write(file, "original")
+    await fs.mkdir(path.join(tmp.path, "nested"))
+    expect(run(["test", "-e", file]).status).toBe(0)
+    expect(run(["test", "-d", file]).status).toBe(1)
+    expect(run(["test", "-d", path.join(tmp.path, "nested")]).status).toBe(0)
+    expect(run(["sh", "-c", 'test ! -e "$1" && test ! -L "$1"', "deltabox-patch", file]).status).toBe(1)
+    expect(run(["ls", "-1A", "--", tmp.path]).stdout).toContain("中文 ' $; notes.txt")
+    const found = run(["find", tmp.path, "-name", "nested"])
+    expect(found.status).toBe(0)
+    expect(found.stdout).toContain(path.join(tmp.path, "nested"))
+    expect(run(["rm", "--", file]).status).toBe(0)
+    expect(run(["test", "-e", file]).status).toBe(1)
+    expect(run(["sh", "-c", 'test ! -e "$1" && test ! -L "$1"', "deltabox-patch", file]).status).toBe(0)
+  })
+
+  test.skipIf(process.platform !== "win32")(
+    "uses DevEco shell selection and runs literal commands in PowerShell 5.1 and 7",
+    async () => {
+      await using tmp = await tmpdir()
+      const shells = [which("powershell.exe"), which("pwsh.exe")].filter((shell): shell is string => Boolean(shell))
+      expect(shells.length).toBeGreaterThan(0)
+      for (const shell of shells) {
+        const file = path.join(tmp.path, "中文 ' $; notes.txt")
+        const command =
+          "[IO.File]::WriteAllText('" + file.replaceAll("'", "''") + "', 'literal $() 中文'); Write-Output '成功'"
+        const argv = windowsArgv(["bash", "-c", command], tmp.path, shell)
+        expect(argv[0]).toBe(Shell.preferred(shell))
+        expect(argv.at(-2)).toBe("-EncodedCommand")
+        expect(Buffer.from(argv.at(-1)!, "base64").toString("utf16le").endsWith(command)).toBe(true)
+        const result = spawnSync(argv[0], argv.slice(1), { cwd: tmp.path, encoding: "utf8", timeout: 15000 })
+        expect(result.error).toBeUndefined()
+        expect(result.status).toBe(0)
+        expect(result.stdout).toContain("成功")
+        expect(await Bun.file(file).text()).toBe("literal $() 中文")
+      }
+      const command = "echo configured-shell"
+      const shell = Shell.preferred("cmd.exe")
+      expect(windowsArgv(["bash", "-c", command], tmp.path, shell)).toEqual([
+        shell,
+        ...Shell.args(shell, command, tmp.path),
+      ])
+      expect(windowsArgv(["custom.exe", "literal $() ' 中文"], tmp.path)).toEqual(["custom.exe", "literal $() ' 中文"])
+    },
+  )
+})
